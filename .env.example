# ashwax v3.0 — .env template
# Copy to .env and fill in real values. .env is git-ignored. Never commit secrets.

# -- Database ---------------------------------------------------------------
DB_URL=postgresql://postgres:CHANGEME@localhost:5432/ashwax

# -- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -- Kite Connect -----------------------------------------------------------
KITE_API_KEY=
KITE_SECRET=
KITE_USER_ID=
# Auto-populated each morning by the TOTP session refresh — do NOT set manually
KITE_ACCESS_TOKEN=

# -- Angel One SmartAPI -------------------------------------------------------
# ANGEL_ONE_API_KEY=
# ANGEL_ONE_CLIENT_CODE=
# Auto-populated by session login/refresh — do NOT set manually
# ANGEL_ONE_ACCESS_TOKEN=
# ANGEL_ONE_REFRESH_TOKEN=

# -- LLM Providers ----------------------------------------------------------
# Primary: Gemini Flash (free tier — https://aistudio.google.com)
GEMINI_API_KEY=
# Optional fallbacks
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Free-tier failover provider (llm.openai_compat in config/global.json); unset = skipped
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# -- Notifications (Telegram) ------------------------------------------------
# BotFather -> /newbot -> token. Chat id: message the bot once, then visit
#   https://api.telegram.org/bot<TOKEN>/getUpdates  -> result[0].message.chat.id
# Leave both blank to disable mobile notifications entirely.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Groq (free tier) -- used by the G9 reviewer / background LLM chain in config/global.json
# GROQ_API_KEY=
# Local Ollama fallback model (last resort; default llama3)
# OLLAMA_MODEL=llama3
# Global LLM rate cap across providers
# LLM_MAX_PER_MINUTE=

# -- Broker mode --------------------------------------------------------------
# paper (default) | kite | angel_one. Leave unset to stay in paper mode.
# BROKER=paper
# BROKER=angel_one

# -- System -----------------------------------------------------------------
# LOG_LEVEL removed 2026-09-23: log level is config/global.json system.log_level
# only (DEBUG/INFO/...), so one file controls it instead of .env silently
# overriding config.
LOG_DATE_FORMAT=%d-%m-%Y %H:%M:%S.%f

# -- TOTP -------------------------------------------------------------------
# Preferred: store secret in Windows Credential Manager via:
#   python -c "import keyring; keyring.set_password('kite_totp', '<KITE_USER_ID>', '<SECRET>')"
# Fallback (dev only — keep out of prod):
# KITE_TOTP_SECRET=

# Angel One TOTP secret + trading PIN — Windows Credential Manager only, never
# an env var (the PIN is the 4-digit trading PIN, not the web login password):
#   python -c "import keyring; keyring.set_password('angel_one_login', '<ANGEL_ONE_CLIENT_CODE>', '<PIN>')"
#   python -c "import keyring; keyring.set_password('angel_one_totp', '<ANGEL_ONE_CLIENT_CODE>', '<SECRET>')"
